---
// Inlines a self-hosted SVG from public/icons/ so it can be recolored via
// CSS `currentColor` (research.md #4) — decorative only, since every usage
// in this feature sits beside a visible text label.
import { readFileSync } from "node:fs";
import { fileURLToPath } from "node:url";

interface Props {
  id: string;
  class?: string;
}

const { id, class: className } = Astro.props;
const svgPath = fileURLToPath(new URL(`../../public/icons/${id}.svg`, import.meta.url));
const raw = readFileSync(svgPath, "utf-8");
const openTag = raw.match(/<svg[^>]*>/s)?.[0] ?? "<svg>";
const hasFill = /\sfill=/.test(openTag);
const injectedAttrs = `<svg aria-hidden="true" class="icon${className ? ` ${className}` : ""}"${
  hasFill ? "" : ' fill="currentColor"'
}`;
const markup = raw.replace("<svg", injectedAttrs);
---

<Fragment set:html={markup} />
