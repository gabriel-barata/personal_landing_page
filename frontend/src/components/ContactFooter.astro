---
import { contactRowLinks } from "../data/contact-links.js";
import { en } from "../data/i18n/en.js";
import { pt } from "../data/i18n/pt.js";
import I18nText from "./I18nText.astro";
---

<footer class="contact-footer" aria-label={en.sections.contact}>
  <h2 class="visually-hidden"><I18nText en={en.sections.contact} pt={pt.sections.contact} /></h2>
  <ul class="contact-row">
    {
      contactRowLinks.map((link) => (
        <li>
          <a class="contact-button" href={link.href}>
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</footer>

<style>
  .contact-footer {
    display: flex;
    flex-direction: column;
    padding: var(--section-gap) var(--space-24) var(--space-24);
    max-width: 900px;
    margin: 0 auto;
  }

  /* Closing bookend to Hero (visual-direction decision 20): one section per
     screen on desktop, content centered like Hero rather than top-aligned,
     since footer has no chapter heading to anchor to. */
  @media (min-width: 768px) {
    .contact-footer {
      min-height: calc(100vh - var(--header-height));
      justify-content: center;
    }
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .contact-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-16);
  }

  .contact-button {
    display: inline-block;
    border: 1px solid var(--color-accent);
    color: var(--color-accent);
    background: transparent;
    padding: var(--space-8) var(--space-16);
    font-size: var(--font-size-4);
    text-decoration: none;
    transition: background-color var(--transition-hover), color var(--transition-hover);
  }

  .contact-button:hover,
  .contact-button:focus-visible {
    background: var(--color-accent);
    color: var(--color-accent-ink);
  }
</style>
