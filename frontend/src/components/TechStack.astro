---
import { techStack } from "../data/tech-stack.js";
import { en } from "../data/i18n/en.js";
import { pt } from "../data/i18n/pt.js";
import I18nText from "./I18nText.astro";
---

<section id="tech-stack" class="tech-stack" aria-label={en.sections.techStack}>
  <div class="chapter-divider" aria-hidden="true"><span class="chapter-tick"></span></div>
  <h2 class="chapter-heading">
    <span class="chapter-number">02/03</span>
    <span class="chapter-rule" aria-hidden="true"></span>
    <span class="chapter-title"><I18nText en={en.sections.techStack} pt={pt.sections.techStack} /></span>
  </h2>

  <div class="categories">
    {
      techStack.map((category) => (
        <div class="category">
          <h3 class="category-label label">{category.label}</h3>
          <ul class="items">
            {category.items.map((techItem) => (
              <li class="item">{techItem.label}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  .tech-stack {
    padding: calc(var(--section-gap) / 2) var(--space-24) 0;
    max-width: 900px;
    margin: 0 auto;
  }

  .chapter-heading {
    margin-bottom: var(--space-24);
  }

  .categories {
    column-count: 2;
    column-gap: var(--space-24);
  }

  .category {
    break-inside: avoid;
    border: 1px solid var(--color-border);
    padding: var(--space-16);
    margin-bottom: var(--space-24);
  }

  .category-label {
    color: var(--color-support);
    margin-bottom: var(--space-12);
  }

  .items {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-16) var(--space-24);
  }

  .item {
    color: var(--color-ink);
    font-size: var(--font-size-4);
    transition: color var(--transition-hover);
  }

  .item:hover,
  .item:focus-within {
    color: var(--color-accent);
  }

  /* One section per screen on desktop (visual-direction decision 20) —
     same min-height formula as Hero (decision 3); content stays top-aligned,
     leftover space collects below the categories. */
  @media (min-width: 768px) {
    .tech-stack {
      min-height: calc(100vh - var(--header-height));
    }
  }

  @media (max-width: 767px) {
    .tech-stack {
      padding: calc(var(--section-gap) / 2) var(--space-16) 0;
    }

    .categories {
      column-count: 1;
    }
  }
</style>
