---
import { techStack } from "../data/tech-stack.js";
import { en } from "../data/i18n/en.js";
import { pt } from "../data/i18n/pt.js";
import Icon from "./Icon.astro";
import I18nText from "./I18nText.astro";
---

<section id="tech-stack" class="tech-stack" aria-label={en.sections.techStack}>
  <h2 class="section-heading label">
    <I18nText en={en.sections.techStack} pt={pt.sections.techStack} />
  </h2>

  <div class="categories">
    {
      techStack.map((category) => (
        <div class="category">
          <h3 class="category-label label">{category.label}</h3>
          <ul class="items">
            {category.items.map((techItem) => (
              <li class="item">
                <Icon id={techItem.iconId} />
                <span class="item-label">{techItem.label}</span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  .tech-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
    padding: var(--section-gap) var(--space-24) 0;
    max-width: 900px;
    margin: 0 auto;
  }

  .section-heading {
    color: var(--color-support);
  }

  .categories {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }

  .category-label {
    color: var(--color-support);
    margin-bottom: var(--space-12);
  }

  .items {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-16) var(--space-24);
  }

  .item {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    color: var(--color-ink);
    transition: color var(--transition-hover);
  }

  .item :global(.icon) {
    color: inherit;
  }

  .item:hover,
  .item:focus-within {
    color: var(--color-accent);
  }

  .item-label {
    font-size: var(--font-size-4);
  }

  @media (max-width: 767px) {
    .tech-stack {
      padding: var(--section-gap) var(--space-16) 0;
    }
  }
</style>
