---
import { contactLinks } from "../data/contact-links.js";
import type { ExperienceEntry } from "../data/experience-placeholder.js";

interface Props {
  entry: ExperienceEntry;
}

const { entry } = Astro.props;
const emailLink = contactLinks.find((link) => link.kind === "email")!;
---

<div
  class="panel"
  data-panel={entry.id}
  id={`panel-${entry.id}`}
  role="dialog"
  aria-modal="true"
  aria-labelledby={`panel-title-${entry.id}`}
  hidden
>
  <div class="title-bar">
    <span class="title" id={`panel-title-${entry.id}`}>{entry.role} — {entry.company}</span>
    <button type="button" class="close-btn" data-panel-close aria-label="Close">
      <svg viewBox="0 0 5 5" width="10" height="10" aria-hidden="true" focusable="false" shape-rendering="crispEdges">
        <rect x="0" y="0" width="1" height="1" fill="currentColor" />
        <rect x="4" y="0" width="1" height="1" fill="currentColor" />
        <rect x="1" y="1" width="1" height="1" fill="currentColor" />
        <rect x="3" y="1" width="1" height="1" fill="currentColor" />
        <rect x="2" y="2" width="1" height="1" fill="currentColor" />
        <rect x="1" y="3" width="1" height="1" fill="currentColor" />
        <rect x="3" y="3" width="1" height="1" fill="currentColor" />
        <rect x="0" y="4" width="1" height="1" fill="currentColor" />
        <rect x="4" y="4" width="1" height="1" fill="currentColor" />
      </svg>
    </button>
  </div>

  <div class="body">
    <p class="echo">{`> cat experience/${entry.id}.md`}</p>

    <dl class="metadata">
      <div class="metadata-row">
        <dt class="label">Position</dt>
        <dd>{entry.role}</dd>
      </div>
      <div class="metadata-row">
        <dt class="label">Industry</dt>
        <dd>{entry.industry}</dd>
      </div>
      <div class="metadata-row">
        <dt class="label">Team Size</dt>
        <dd>{entry.teamSize}</dd>
      </div>
      {
        entry.isLead && (
          <div class="metadata-row">
            <dt class="label">Lead</dt>
            <dd>Yes</dd>
          </div>
        )
      }
    </dl>

    <section class="bullets">
      <h4 class="label">Tasks</h4>
      <ul>
        {entry.tasks.map((task) => <li>{task}</li>)}
      </ul>
    </section>

    <section class="bullets">
      <h4 class="label">Achievements</h4>
      <ul>
        {entry.achievements.map((achievement) => <li>{achievement}</li>)}
      </ul>
    </section>

    <p class="cursor-line" aria-hidden="true">{"> "}<span class="cursor">|</span></p>

    <a class="contact-cta" href={emailLink.href}>Contact me</a>
  </div>
</div>

<style>
  .panel {
    position: absolute;
    inset: 0;
    height: 80vh;
    display: flex;
    flex-direction: column;
    background: var(--color-base);
    border: 1px solid var(--color-border);
    font-family: "Space Mono", ui-monospace, monospace;
    animation: panel-open 160ms steps(4, end);
  }

  .panel[hidden] {
    display: none;
  }

  /* Opening flicker — a hard-step reveal (no easing curve) rather than a
     smooth fade, so it reads as a screen snapping on rather than a modern
     window animating in. Close stays instant (visual-direction decision 21,
     2026-07-26 retro reversal). */
  @keyframes panel-open {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .panel {
      animation: none;
    }
  }

  .title-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-16);
    padding: var(--space-12) var(--space-16);
    background: var(--color-accent);
    flex-shrink: 0;
  }

  .title {
    color: var(--color-accent-ink);
    font-size: var(--font-size-4);
    text-align: left;
  }

  /* Beveled square close control — Windows 3.1/95-style raised button,
     replacing the macOS traffic-light dots (visual-direction decision 21,
     2026-07-26 retro reversal). Highlight/shadow edges reuse the existing
     neutral ramp (tokens.css) rather than adding new colors. */
  .close-btn {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    background: var(--bevel-face);
    color: var(--color-ink);
    border-style: solid;
    border-width: 2px;
    border-color: var(--bevel-highlight) var(--bevel-shadow) var(--bevel-shadow) var(--bevel-highlight);
    cursor: pointer;
    transition: color var(--transition-hover), border-color var(--transition-hover);
  }

  .close-btn:hover,
  .close-btn:focus-visible {
    color: var(--color-accent);
    border-top-color: var(--color-accent);
    border-left-color: var(--color-accent);
  }

  .close-btn:active {
    border-color: var(--bevel-shadow) var(--bevel-highlight) var(--bevel-highlight) var(--bevel-shadow);
    transform: translate(1px, 1px);
  }

  .body {
    flex: 1;
    overflow-y: auto;
    padding: var(--space-16);
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }

  .echo {
    color: var(--color-support);
    font-size: var(--font-size-4);
  }

  .metadata {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .metadata-row {
    display: flex;
    gap: var(--space-12);
    font-size: var(--font-size-4);
  }

  .metadata-row .label {
    flex-shrink: 0;
    width: 100px;
    color: var(--color-support);
  }

  .metadata-row dd {
    margin: 0;
    color: var(--color-ink);
  }

  .bullets .label {
    color: var(--color-support);
    margin-bottom: var(--space-8);
  }

  .bullets ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .bullets li {
    position: relative;
    padding-left: var(--space-16);
    color: var(--color-ink);
    font-size: var(--font-size-4);
  }

  .bullets li::before {
    content: "-";
    position: absolute;
    left: 0;
    color: var(--color-accent);
  }

  .cursor-line {
    color: var(--color-support);
    font-size: var(--font-size-4);
  }

  .cursor {
    color: var(--color-ink);
    animation: cursor-blink 1060ms linear infinite;
  }

  @keyframes cursor-blink {
    0%,
    50% {
      opacity: 1;
    }
    50.01%,
    100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
      opacity: 1;
    }
  }

  /* Beveled CTA — matches the close button's raised treatment
     (visual-direction decision 21, 2026-07-26 retro reversal). */
  .contact-cta {
    display: block;
    align-self: center;
    background: var(--bevel-face);
    color: var(--color-ink);
    border-style: solid;
    border-width: 2px;
    border-color: var(--bevel-highlight) var(--bevel-shadow) var(--bevel-shadow) var(--bevel-highlight);
    padding: var(--space-12) var(--space-24);
    font-size: var(--font-size-3);
    text-decoration: none;
    transition: color var(--transition-hover), border-color var(--transition-hover);
  }

  .contact-cta:hover,
  .contact-cta:focus-visible {
    color: var(--color-accent);
    border-top-color: var(--color-accent);
    border-left-color: var(--color-accent);
  }

  .contact-cta:active {
    border-color: var(--bevel-shadow) var(--bevel-highlight) var(--bevel-highlight) var(--bevel-shadow);
    transform: translate(1px, 1px);
  }

  @media (max-width: 767px) {
    .panel {
      height: 70vh;
    }
  }
</style>
