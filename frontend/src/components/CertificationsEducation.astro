---
import { certifications } from "../data/certifications.js";
import { education } from "../data/education.js";
import { en } from "../data/i18n/en.js";
import { pt } from "../data/i18n/pt.js";
import I18nText from "./I18nText.astro";

function parseAcquired(acquired: string): number {
  const [month, year] = acquired.split("/").map(Number);
  return year * 12 + month;
}

const sortedCertifications = [...certifications].sort(
  (a, b) => parseAcquired(b.acquired) - parseAcquired(a.acquired),
);
---

<section
  id="certifications-education"
  class="cert-edu"
  aria-label={en.sections.educationCertifications}
>
  <div class="chapter-divider" aria-hidden="true"><span class="chapter-tick"></span></div>
  <h2 class="chapter-heading">
    <span class="chapter-number">03/03</span>
    <span class="chapter-rule" aria-hidden="true"></span>
    <span class="chapter-title"
      ><I18nText en={en.sections.educationCertifications} pt={pt.sections.educationCertifications} /></span
    >
  </h2>

  <div class="cert-group">
    <h3 class="sub-heading label">
      <I18nText en={en.sections.certifications} pt={pt.sections.certifications} />
    </h3>
    <ul class="cert-list">
      {
        sortedCertifications.map((cert) => (
          <li class="cert-row">
            <a class="cert-link" href={cert.credentialUrl} target="_blank" rel="noopener noreferrer">
              <img
                class="cert-image"
                src={cert.badgeImagePath}
                alt={cert.badgeAlt}
                loading="lazy"
                width="96"
                height="96"
              />
              <span class="cert-text">
                <span class="cert-name">{cert.name}</span>
                <span class="cert-issuer">{cert.issuer}</span>
              </span>
              <span class="cert-date tabular-nums">{cert.acquired}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="education-group">
    <h3 class="sub-heading label">
      <I18nText en={en.sections.education} pt={pt.sections.education} />
    </h3>
    <ul class="education-list">
      {
        education.map((entry) => (
          <li class="education-entry">
            <p class="education-degree">{entry.degree}</p>
            <p class="education-institution">{entry.institution}</p>
            <p class="education-status">{entry.completionStatus}</p>
            {entry.note && <p class="education-note">{entry.note}</p>}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .cert-edu {
    padding: calc(var(--section-gap) / 2) var(--space-24) 0;
    max-width: 900px;
    margin: 0 auto;
  }

  .chapter-heading {
    margin-bottom: var(--space-24);
  }

  .sub-heading {
    color: var(--color-support);
    margin-bottom: var(--space-12);
  }

  .education-group {
    margin-top: var(--space-32);
  }

  .cert-list {
    display: flex;
    flex-direction: column;
  }

  .cert-row {
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-16) 0;
  }

  .cert-row:first-child {
    padding-top: 0;
  }

  .cert-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .cert-link {
    display: flex;
    align-items: center;
    gap: var(--space-16);
    color: inherit;
    text-decoration: none;
  }

  .cert-image {
    flex-shrink: 0;
    width: 96px;
    height: 96px;
    object-fit: contain;
    border: 1px solid var(--color-border);
    background: var(--color-badge-backing);
    filter: grayscale(1);
    transition: filter var(--transition-hover);
  }

  .cert-link:hover .cert-image,
  .cert-link:focus-visible .cert-image {
    filter: grayscale(0);
  }

  .cert-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    flex: 1;
    min-width: 0;
  }

  .cert-issuer {
    font-size: var(--font-size-5);
    color: var(--color-support);
  }

  .cert-name {
    font-family: "Space Grotesk Variable", sans-serif;
    font-weight: 500;
    color: var(--color-ink);
    line-height: 1.4;
  }

  .cert-date {
    flex-shrink: 0;
    font-size: var(--font-size-5);
    color: var(--color-support);
  }

  .education-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  .education-entry {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-bottom: var(--space-16);
    border-bottom: 1px solid var(--color-border);
  }

  .education-entry:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .education-degree {
    color: var(--color-ink);
    font-family: "Space Grotesk Variable", sans-serif;
    font-weight: 500;
  }

  .education-institution {
    color: var(--color-ink);
    font-size: var(--font-size-4);
  }

  .education-status {
    color: var(--color-support);
    font-size: var(--font-size-5);
  }

  .education-note {
    color: var(--color-support);
    font-size: var(--font-size-4);
    max-width: 65ch;
  }

  /* One section per screen on desktop (visual-direction decision 20) —
     same min-height formula as Hero (decision 3); content stays top-aligned,
     leftover space collects below the certifications/education lists. */
  @media (min-width: 768px) {
    .cert-edu {
      min-height: calc(100vh - var(--header-height));
    }
  }

  @media (max-width: 767px) {
    .cert-edu {
      padding: calc(var(--section-gap) / 2) var(--space-16) 0;
    }

    .cert-link {
      flex-wrap: wrap;
    }

    .cert-date {
      flex-basis: 100%;
      margin-left: calc(96px + var(--space-16));
    }
  }
</style>
