---
import { experiencePlaceholder } from "../data/experience-placeholder.js";
import { en } from "../data/i18n/en.js";
import { pt } from "../data/i18n/pt.js";
import { formatExperienceDate } from "../lib/format-date.js";
import I18nText from "./I18nText.astro";
import ExperienceDetailPanel from "./ExperienceDetailPanel.astro";
---

<section id="experience" class="experience" aria-label={en.sections.experience}>
  <div class="chapter-divider" aria-hidden="true"><span class="chapter-tick"></span></div>
  <h2 class="chapter-heading">
    <span class="chapter-number">01/04</span>
    <span class="chapter-rule" aria-hidden="true"></span>
    <span class="chapter-title"><I18nText en={en.sections.experience} pt={pt.sections.experience} /></span>
  </h2>

  <div class="timeline-wrap">
    <ol class="timeline">
      {
        experiencePlaceholder.map((entry) => (
          <li class="entry">
            <div class="rail">
              <span class={`tick ${entry.isCurrent ? "tick-current" : ""}`} />
            </div>
            <p class="dates tabular-nums">
              {formatExperienceDate(entry.startDate)} – {formatExperienceDate(entry.endDate)}
            </p>
            <div class="content">
              <p class="role-line">
                <span class="role">{entry.role}</span> · <span class="company">{entry.company}</span>
              </p>
              <p class="summary">{entry.summary}</p>
              <button
                type="button"
                class="details-button"
                data-panel-open={entry.id}
                aria-controls={`panel-${entry.id}`}
              >
                Details
              </button>
            </div>
          </li>
        ))
      }
    </ol>

    {experiencePlaceholder.map((entry) => <ExperienceDetailPanel entry={entry} />)}
  </div>
</section>

<script>
  import { nextFocusIndex } from "../lib/experience-panel.js";

  const timeline = document.querySelector<HTMLOListElement>(".timeline");
  const panels = document.querySelectorAll<HTMLElement>("[data-panel]");
  const openButtons = document.querySelectorAll<HTMLButtonElement>("[data-panel-open]");

  let triggerButton: HTMLButtonElement | null = null;

  function getPanel(id: string): HTMLElement | undefined {
    return Array.from(panels).find((panel) => panel.dataset.panel === id);
  }

  function getFocusableElements(panel: HTMLElement): HTMLElement[] {
    return Array.from(
      panel.querySelectorAll<HTMLElement>('button, a[href], [tabindex]:not([tabindex="-1"])'),
    );
  }

  function openPanel(id: string, trigger: HTMLButtonElement) {
    const target = getPanel(id);
    if (!target || !timeline) return;

    for (const panel of panels) {
      if (panel !== target) {
        panel.hidden = true;
      }
    }

    target.hidden = false;
    timeline.inert = true;
    triggerButton = trigger;

    const focusable = getFocusableElements(target);
    focusable[0]?.focus();
  }

  function closeOpenPanel() {
    const openPanelEl = Array.from(panels).find((panel) => !panel.hidden);
    if (!openPanelEl || !timeline) return;

    openPanelEl.hidden = true;
    timeline.inert = false;

    const trigger = triggerButton;
    triggerButton = null;
    trigger?.focus();
  }

  for (const button of openButtons) {
    button.addEventListener("click", () => {
      const id = button.dataset.panelOpen;
      if (id) openPanel(id, button);
    });
  }

  for (const panel of panels) {
    const closeButton = panel.querySelector<HTMLButtonElement>("[data-panel-close]");
    closeButton?.addEventListener("click", () => closeOpenPanel());

    panel.addEventListener("keydown", (event) => {
      if (event.key !== "Tab") return;

      const focusable = getFocusableElements(panel);
      if (focusable.length === 0) return;

      const currentIndex = focusable.indexOf(document.activeElement as HTMLElement);
      const direction = event.shiftKey ? -1 : 1;
      const nextIndex = nextFocusIndex(currentIndex === -1 ? 0 : currentIndex, focusable.length, direction);

      event.preventDefault();
      focusable[nextIndex]?.focus();
    });
  }

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    const isOpen = Array.from(panels).some((panel) => !panel.hidden);
    if (!isOpen) return;
    closeOpenPanel();
  });
</script>

<style>
  .experience {
    padding: calc(var(--section-gap) / 2) var(--space-24) 0;
    max-width: 900px;
    margin: 0 auto;
  }

  .chapter-heading {
    margin-bottom: var(--space-24);
  }

  .timeline-wrap {
    position: relative;
  }

  .timeline {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }

  .entry {
    position: relative;
    display: grid;
    grid-template-columns: 160px 1fr;
    column-gap: var(--space-24);
  }

  .rail {
    position: absolute;
    top: 0;
    bottom: calc(-1 * var(--space-24));
    left: 160px;
    width: 1px;
    background: var(--color-border);
  }

  .entry:last-child .rail {
    bottom: 0;
  }

  .tick {
    position: absolute;
    top: 4px;
    left: -4px;
    width: 9px;
    height: 9px;
    background: var(--color-base);
    border: 1px solid var(--color-support);
  }

  .tick-current {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .dates {
    color: var(--color-support);
    font-size: var(--font-size-4);
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 65ch;
  }

  /* One section per screen on desktop (visual-direction decision 20) —
     same min-height formula as Hero (decision 3); content stays top-aligned,
     leftover space collects below the timeline. */
  @media (min-width: 768px) {
    .experience {
      min-height: calc(100vh - var(--header-height));
    }
  }

  .role-line {
    color: var(--color-ink);
  }

  .role {
    font-family: "Space Grotesk Variable", sans-serif;
    font-weight: 500;
  }

  .company {
    color: var(--color-support);
  }

  .summary {
    color: var(--color-ink);
    font-size: var(--font-size-4);
  }

  /* Beveled button — Windows 3.1/95-style raised treatment, scoped to the
     Experience detail panel's own controls only (visual-direction decision
     21, 2026-07-26 retro reversal). Site-wide buttons elsewhere keep
     decision 11's flat outline/fill style unchanged. */
  .details-button {
    align-self: flex-start;
    margin-top: var(--space-8);
    background: var(--bevel-face);
    color: var(--color-ink);
    border-style: solid;
    border-width: 2px;
    border-color: var(--bevel-highlight) var(--bevel-shadow) var(--bevel-shadow) var(--bevel-highlight);
    padding: var(--space-8) var(--space-16);
    font-size: var(--font-size-4);
    transition: color var(--transition-hover), border-color var(--transition-hover);
  }

  .details-button:hover,
  .details-button:focus-visible {
    color: var(--color-accent);
    border-top-color: var(--color-accent);
    border-left-color: var(--color-accent);
  }

  .details-button:active {
    border-color: var(--bevel-shadow) var(--bevel-highlight) var(--bevel-highlight) var(--bevel-shadow);
    transform: translate(1px, 1px);
  }

  @media (max-width: 767px) {
    .experience {
      padding: calc(var(--section-gap) / 2) var(--space-16) 0;
    }

    .entry {
      grid-template-columns: 1fr;
      row-gap: var(--space-4);
      padding-left: var(--space-24);
    }

    .rail {
      left: 0;
    }
  }
</style>
