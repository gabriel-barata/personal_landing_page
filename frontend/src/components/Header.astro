---
import { contactLinks } from "../data/contact-links.js";
import { en } from "../data/i18n/en.js";
import { pt } from "../data/i18n/pt.js";
import I18nText from "./I18nText.astro";
import LanguageToggle from "./LanguageToggle.astro";
import ThemeToggle from "./ThemeToggle.astro";

const cv = contactLinks.find((link) => link.kind === "cv")!;
---

<header class="site-header">
  <div class="cluster">
    <LanguageToggle />
    <span class="cluster-sep">/</span>
    <ThemeToggle />
    <a class="cv-button" href={cv.href}>
      <I18nText en={en.microcopy.downloadCv} pt={pt.microcopy.downloadCv} />
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-16);
    padding: var(--space-16) var(--space-24);
  }

  .cluster {
    display: flex;
    align-items: center;
    gap: var(--space-16);
  }

  .cluster-sep {
    color: var(--color-border);
  }

  .cv-button {
    display: inline-block;
    border: 1px solid var(--color-accent);
    color: var(--color-accent);
    background: transparent;
    padding: var(--space-8) var(--space-16);
    font-size: var(--font-size-4);
    text-decoration: none;
    transition: background-color var(--transition-hover), color var(--transition-hover);
  }

  .cv-button:hover,
  .cv-button:focus-visible {
    background: var(--color-accent);
    color: var(--color-accent-ink);
  }

  @media (max-width: 767px) {
    .site-header {
      padding: var(--space-12) var(--space-16);
      flex-wrap: wrap;
      row-gap: var(--space-8);
    }

    .cluster {
      flex-wrap: wrap;
      row-gap: var(--space-8);
      gap: var(--space-8) var(--space-12);
    }
  }
</style>
