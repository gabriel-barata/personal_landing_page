---
import { education } from "../data/education.js";
import { projects } from "../data/projects.js";
import { en } from "../data/i18n/en.js";
import { pt } from "../data/i18n/pt.js";
import I18nText from "./I18nText.astro";
---

<section id="education-projects" class="education-projects" aria-label={en.sections.educationProjects}>
  <div class="chapter-divider" aria-hidden="true"><span class="chapter-tick"></span></div>
  <h2 class="chapter-heading">
    <span class="chapter-number">04/04</span>
    <span class="chapter-rule" aria-hidden="true"></span>
    <span class="chapter-title"
      ><I18nText en={en.sections.educationProjects} pt={pt.sections.educationProjects} /></span
    >
  </h2>

  <div class="education-group">
    <h3 class="sub-heading label">
      <I18nText en={en.sections.education} pt={pt.sections.education} />
    </h3>
    <ul class="education-list">
      {
        education.map((entry) => (
          <li class="education-entry">
            <p class="education-degree">{entry.degree}</p>
            <p class="education-institution">{entry.institution}</p>
            <p class="education-status">{entry.completionStatus}</p>
            {entry.note && <p class="education-note">{entry.note}</p>}
          </li>
        ))
      }
    </ul>
  </div>

  <div class="projects-group">
    <h3 class="sub-heading label">
      <I18nText en={en.sections.projects} pt={pt.sections.projects} />
    </h3>
    <ul class="project-list">
      {
        projects.map((project) => (
          <li class="project-entry">
            <p class="project-name">{project.name}</p>
            <p class="project-description">{project.description}</p>
            <ul class="project-tags">
              {project.tags.map((tag) => (
                <li class="project-tag">{tag}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .education-projects {
    padding: calc(var(--section-gap) / 2) var(--space-24) 0;
    max-width: 900px;
    margin: 0 auto;
  }

  .chapter-heading {
    margin-bottom: var(--space-24);
  }

  .sub-heading {
    color: var(--color-support);
    margin-bottom: var(--space-12);
  }

  .projects-group {
    margin-top: var(--space-32);
  }

  .education-list,
  .project-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  .education-entry,
  .project-entry {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-bottom: var(--space-16);
    border-bottom: 1px solid var(--color-border);
  }

  .education-entry:last-child,
  .project-entry:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .education-degree,
  .project-name {
    color: var(--color-ink);
    font-family: "Space Grotesk Variable", sans-serif;
    font-weight: 500;
  }

  .education-institution {
    color: var(--color-ink);
    font-size: var(--font-size-4);
  }

  .education-status {
    color: var(--color-support);
    font-size: var(--font-size-5);
  }

  .education-note {
    color: var(--color-support);
    font-size: var(--font-size-4);
    max-width: 65ch;
  }

  .project-description {
    color: var(--color-ink);
    font-size: var(--font-size-4);
    max-width: 65ch;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    margin-top: var(--space-4);
  }

  .project-tag {
    border: 1px solid var(--color-border);
    padding: var(--space-4) var(--space-8);
    font-family: "Space Mono", ui-monospace, monospace;
    font-size: var(--font-size-5);
    color: var(--color-support);
  }

  /* One section per screen on desktop (visual-direction decision 20) —
     same min-height formula as Hero (decision 3); content stays top-aligned,
     leftover space collects below the education/projects lists. */
  @media (min-width: 768px) {
    .education-projects {
      min-height: calc(100vh - var(--header-height));
    }
  }

  @media (max-width: 767px) {
    .education-projects {
      padding: calc(var(--section-gap) / 2) var(--space-16) 0;
    }
  }
</style>
